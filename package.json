{
  "name": "@yaireo/tagify",
  "version": "4.39.0",
  "homepage": "https://github.com/yairEO/tagify",
  "description": "lightweight, efficient Tags input component in Vanilla JS / React / Angular [super customizable, tiny size & top performance]",
  "keywords": [
    "tags",
    "tagging",
    "component",
    "tag",
    "ui"
  ],
  "license": "MIT",
  "browserslist": [
    "defaults",
    "not ie 11",
    "not op_mini all",
    "not chrome < 111",
    "not kaios > 0",
    "not and_qq > 0",
    "not and_uc > 0"
  ],
  "engines": {
    "pnpm": ">=10",
    "node": ">=22"
  },
  "np": {
    "yarn": false,
    "yolo": true
  },
  "scripts": {
    "start": "gulp --dev",
    "build": "gulp build",
    "version": "gulp build && git add -u",
    "prepublishOnly": "pjv",
    "test": "pnpm exec playwright test",
    "serve": "npx http-server -o index.html -c-1"
  },
  "jest": {
    "preset": "jest-puppeteer"
  },
  "author": "Yair Even-Or <vsync.design@gmail.com>",
  "main": "./dist/tagify.js",
  "exports": {
    ".": {
      "import": "./dist/tagify.esm.js",
      "require": "./dist/tagify.js"
    },
    "./react": "./src/react.tagify.js",
    "./react.tagify": "./src/react.tagify.js",
    "./dist/react.tagify": "./src/react.tagify.js",
    "./dist/react.tagify.jsx": "./src/react.tagify.js",
    "./dist/tagify.min.js": "./dist/tagify.js",
    "./dist/tagify.min": "./dist/tagify.js",
    "./dist/tagify.esm.js": "./dist/tagify.esm.js",
    "./dist/tagify.vue": "./dist/tagify.vue",
    "./vue": "./dist/tagify.vue",
    "./dist/tagify.css": "./dist/tagify.css",
    "./src/tagify.css": "./src/tagify.css",
    "./src/tagify.scss": "./src/tagify.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yairEO/tagify.git"
  },
  "bugs": {
    "url": "https://github.com/yaireo/tagify/issues"
  },
  "files": [
    "/dist",
    "/src"
  ],
  "peerDependencies": {
    "prop-types": ">15.5.7",
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/stream": "^3.0.1",
    "@types/node": "^26.6.5",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-insert": "^0.5.0",
    "gulp-load-plugins": "^2.0.8",
    "gulp-nunjucks": "^6.1.0",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-tap": "^2.0.0",
    "gulp-terser": "^2.1.0",
    "rollup": "4.64.7",
    "rollup-plugin-banner2": "^1.3.1",
    "semver": "^7.8.5",
    "vinyl-buffer": "^1.0.1",
    "vinyl-source-stream": "^2.0.0"
  }
}
